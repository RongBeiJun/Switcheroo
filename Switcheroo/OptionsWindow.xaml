<Window x:Class="Switcheroo.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource OptionsTitle}" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        ShowInTaskbar="False" WindowStyle="ToolWindow" Background="{x:Static SystemColors.WindowBrush}" Height="380"
        MaxWidth="350">
    <Window.Resources>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="5,5,5,5">
            <CheckBox Name="HotKeyCheckBox" Margin="5,5,5,1" Checked="HotKeyCheckBox_Checked" Unchecked="HotKeyCheckBox_OnUnchecked" Content="{DynamicResource OptHotkey}" />
            <TextBox Name="HotkeyPreview" Margin="25,5,0,10"
                     PreviewKeyDown="HotkeyPreview_OnPreviewKeyDown"
                     GotFocus="HotkeyPreview_OnGotFocus"
                     LostFocus="HotkeyPreview_OnLostFocus"
                     Width="150"
                     HorizontalAlignment="Left"/>
            <CheckBox Name="AltTabCheckBox" Checked="AltTabCheckBox_OnChecked" Unchecked="AltTabCheckBox_OnUnchecked" Margin="5,5,5,1" Content="{DynamicResource OptAltTab}" />
            <TextBlock Margin="25,0,5,10" FontSize="10" Foreground="DimGray" TextWrapping="Wrap"
                       Text="{DynamicResource OptAltTabTip}">
            </TextBlock>
            <CheckBox Name="AutoSwitch" Margin="5,5,5,1" Content="{DynamicResource OptAutoSwitch}" />
            <TextBlock Margin="25,0,5,10" FontSize="10" Foreground="DimGray" TextWrapping="Wrap"
                       Text="{DynamicResource OptAutoSwitchTip}">
            </TextBlock>
            <CheckBox x:Name="RunAsAdministrator" Margin="5,5,5,1" Content="{DynamicResource OptRunAsAdmin}"/>
            <TextBlock Margin="25,0,5,10" FontSize="10" Foreground="DimGray" TextWrapping="Wrap"
                       Text="{DynamicResource OptRunAsAdminTip}">
            </TextBlock>
            <TextBlock Margin="25,0,5,10" Foreground="DimGray" TextWrapping="Wrap"
                       Text="{DynamicResource OptTheme}" />
            <ComboBox Name="Theme" Margin="25,0,30,10">
                <ComboBoxItem Content="Light" />
                <ComboBoxItem Content="Dark" />
            </ComboBox>
            <TextBlock Margin="25,0,5,10" Foreground="DimGray" TextWrapping="Wrap"
                       Text="{DynamicResource OptLanguage}" />
            <ComboBox Name="LanguageComboBox" Margin="25,0,30,10">
                <ComboBoxItem Tag="zh">中文</ComboBoxItem>
                <ComboBoxItem Tag="en">English</ComboBoxItem>
            </ComboBox>
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button Name="Ok" Width="60" Click="Ok_Click" IsDefault="True" Margin="0,0,5,0" Grid.Column="0" Content="{DynamicResource OptOk}" />
                <Button Name="Cancel" Width="60" Click="Cancel_Click" IsCancel="True" Margin="5,0,0,0" Grid.Column="1" Content="{DynamicResource OptCancel}" />
            </Grid>
        </StackPanel>
    </Grid>

</Window>
