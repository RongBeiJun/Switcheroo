<Window x:Class="Switcheroo.MainWindow" WindowStartupLocation="CenterScreen" Topmost="True"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Switcheroo"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        Closing="OnClose" ResizeMode="NoResize" ShowInTaskbar="False" WindowStyle="None"
        AllowsTransparency="True"
        SizeToContent="WidthAndHeight"
        Title="" MinWidth="800" Deactivated="MainWindow_OnLostFocus" Loaded="MainWindow_OnLoaded">

    <Window.CommandBindings>
        <CommandBinding Command="local:MainWindow.CloseWindowCommand"
                        Executed="CloseWindow" />
        <CommandBinding Command="local:MainWindow.SwitchToWindowCommand"
                        Executed="OnEnterPressed" />
        <CommandBinding Command="local:MainWindow.ScrollListUpCommand"
                        Executed="ScrollListUp" />
        <CommandBinding Command="local:MainWindow.ScrollListDownCommand"
                        Executed="ScrollListDown" />
        <CommandBinding Command="local:MainWindow.ScrollListPageUpCommand" 
                        Executed="ScrollListPageUp" />
        <CommandBinding Command="local:MainWindow.ScrollListPageDownCommand" 
                        Executed="ScrollListPageDown" />
        <CommandBinding Command="local:MainWindow.ScrollListHomeCommand" 
                        Executed="ScrollListHome" />
        <CommandBinding Command="local:MainWindow.ScrollListEndCommand" 
                        Executed="ScrollListEnd" />
    </Window.CommandBindings>

    <Window.InputBindings>
        <KeyBinding Command="local:MainWindow.CloseWindowCommand" Key="W" Modifiers="Ctrl" />
        <KeyBinding Command="local:MainWindow.CloseWindowCommand" Key="X" Modifiers="Alt" />
        <KeyBinding Command="local:MainWindow.ScrollListUpCommand" Key="Up" />
        <KeyBinding Command="local:MainWindow.ScrollListDownCommand" Key="Down" />
        <KeyBinding Command="local:MainWindow.ScrollListUpCommand" Key="K" Modifiers="Alt" />
        <KeyBinding Command="local:MainWindow.ScrollListDownCommand" Key="J" Modifiers="Alt" />
        <KeyBinding Command="local:MainWindow.ScrollListPageUpCommand" Key="PageUp" />
        <KeyBinding Command="local:MainWindow.ScrollListPageDownCommand" Key="PageDown" />
        <KeyBinding Command="local:MainWindow.ScrollListHomeCommand" Key="Home" />
        <KeyBinding Command="local:MainWindow.ScrollListEndCommand" Key="End" />
    </Window.InputBindings>

    <Window.Resources>
        <local:WindowHandleToIconConverter x:Key="WindowHandleToIconConverter" />
        <local:WindowHandleToCachedIconConverter x:Key="WindowHandleToCachedIconConverter" />
        <!-- 列表空态：有项时隐藏、无项时显示 -->
        <local:BoolToVisibilityConverter x:Key="InverseHasItemsToVisibility" IfTrue="Collapsed" IfFalse="Visible" />
        <!-- 列表项状态色（供 VSM ColorAnimation 过渡，浅/深色主题均可读） -->
        <Color x:Key="ItemSelectedColor">#552680E0</Color>
        <Color x:Key="ItemHoverColor">#14000000</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="#4A90D9" />
    </Window.Resources>

    <Border Padding="3" Background="White" Name="Border" CornerRadius="8">
        <DockPanel LastChildFill="True">
            <!--帮助信息-->
            <DockPanel Margin="4,0,4,0" Name="HelpPanel" Background="Transparent" Height="0" DockPanel.Dock="Top">
                <TextBlock FontSize="12" DockPanel.Dock="Left" Text="{DynamicResource HelpTypeToSearch}" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock FontSize="12" Margin="0,0,8,0" Text="{DynamicResource HelpNavigate}"
                               ToolTip="{DynamicResource HelpNavigateTip}" />
                    <TextBlock FontSize="12" Margin="0,0,8,0" Text="{DynamicResource HelpEnter}"
                               ToolTip="{DynamicResource HelpEnterTip}" />
                    <TextBlock FontSize="12" Margin="0,0,8,0" Text="{DynamicResource HelpClose}"
                               ToolTip="{DynamicResource HelpCloseTip}" />
                    <TextBlock FontSize="12" Text="{DynamicResource HelpDismiss}"
                               ToolTip="{DynamicResource HelpDismissTip}" />
                </StackPanel>
            </DockPanel>
            <!--程序分组信息-->
            <DockPanel Margin="4,0,4,0" Name="ProcessPanel" Background="Transparent" DockPanel.Dock="Top">
                <TextBlock FontSize="20" DockPanel.Dock="Left">
                </TextBlock>
                <WrapPanel Name="spProcessFilter" DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,2,0,2">
                </WrapPanel>
            </DockPanel>
            <!--搜索框-->
           <Grid Name="SearchGrid" DockPanel.Dock="Top">
                <TextBox Name="tb" Margin="4,4,4,2" FontSize="20" TextChanged="TextChanged"
                         TextAlignment="Left" CaretBrush="#4A90D9" FocusVisualStyle="{x:Null}">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <Grid>
                                <!-- 圆角填充背景 -->
                                <Border x:Name="Bg" CornerRadius="7" Background="#F1F3F6" />
                                <!-- 圆角描边（Rectangle 描边是真圆角，模板内动画可靠解析） -->
                                <Rectangle x:Name="Frame" RadiusX="7" RadiusY="7" Stroke="#DCE2E8"
                                           StrokeThickness="1.5" Fill="{x:Null}" IsHitTestVisible="False" />
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                              Margin="10,5,10,5" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- 聚焦动效：描边加粗变蓝 + 背景淡蓝（属性系统驱动，模板内 TargetName 可靠） -->
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="Frame"
                                                    Storyboard.TargetProperty="(Rectangle.Stroke).(SolidColorBrush.Color)"
                                                    To="#4A90D9" Duration="0:0:0.15" />
                                                <DoubleAnimation Storyboard.TargetName="Frame"
                                                    Storyboard.TargetProperty="StrokeThickness"
                                                    To="2.5" Duration="0:0:0.15" />
                                                <ColorAnimation Storyboard.TargetName="Bg"
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#E8F2FC" Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="Frame"
                                                    Storyboard.TargetProperty="(Rectangle.Stroke).(SolidColorBrush.Color)"
                                                    To="#DCE2E8" Duration="0:0:0.20" />
                                                <DoubleAnimation Storyboard.TargetName="Frame"
                                                    Storyboard.TargetProperty="StrokeThickness"
                                                    To="1.5" Duration="0:0:0.20" />
                                                <ColorAnimation Storyboard.TargetName="Bg"
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#F1F3F6" Duration="0:0:0.20" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </TextBox.Template>
                    <TextBox.InputBindings>
                        <!-- For now, leave these here.  Would it be better to route them upward? -->
                        <KeyBinding Command="local:MainWindow.ScrollListUpCommand" Key="Up" />
                        <KeyBinding Command="local:MainWindow.ScrollListDownCommand" Key="Down" />
                        <KeyBinding Command="local:MainWindow.ScrollListUpCommand" Key="Tab" Modifiers="Shift" />
                        <KeyBinding Command="local:MainWindow.ScrollListDownCommand" Key="Tab" />
                        <KeyBinding Command="local:MainWindow.ScrollListPageUpCommand" Key="Prior" />
                        <KeyBinding Command="local:MainWindow.ScrollListPageDownCommand" Key="PageDown" />
                        <KeyBinding Command="local:MainWindow.ScrollListHomeCommand" Key="Home" />
                        <KeyBinding Command="local:MainWindow.ScrollListEndCommand" Key="End" />
                    </TextBox.InputBindings>
                </TextBox>
               <!--帮助按钮-->
                <TextBlock Margin="0,0,10,0" Width="15" HorizontalAlignment="Right" TextAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="18" FontWeight="Bold" Opacity="0.4"
                           PreviewMouseDown="ShowHelpTextBlock_OnPreviewMouseDown"
                           Name="ShowHelpTextBlock" Cursor="Hand" Foreground="DarkGray">
                    <TextBlock.Text>?</TextBlock.Text>
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <EventTrigger.Actions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Duration="0:0:0.150" Storyboard.TargetProperty="Opacity"
                                                         To="1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger.Actions>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <EventTrigger.Actions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Duration="0:0:0.150" Storyboard.TargetProperty="Opacity"
                                                         To="0.4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger.Actions>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
            </Grid>
            <!--窗口列表-->
            <Grid DockPanel.Dock="Bottom" Margin="-1,3,-1,0">
            <ListBox Name="lb" SelectionMode="Extended" ItemsSource="{Binding}" MinWidth="780" BorderThickness="0"
                     Margin="0" Padding="0" FontSize="16" MouseLeave="ListBox_MouseLeave"
                     PreviewMouseWheel="ListBox_PreviewMouseWheel" FocusVisualStyle="{x:Null}"
                     ScrollViewer.CanContentScroll="True">
                <ListBox.Template>
                    <ControlTemplate TargetType="{x:Type ListBox}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <ScrollViewer x:Name="ScrollViewer" Focusable="False" CanContentScroll="True"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter Margin="{TemplateBinding Padding}" />
                                </ScrollViewer>
                                <!-- 选中高亮滑块：选中项变化时上下滑动到位 -->
                                <Border x:Name="SelectionHighlight" IsHitTestVisible="False" CornerRadius="7"
                                        Background="{StaticResource AccentBrush}" Opacity="0.35"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                        Margin="2,0" Visibility="Collapsed">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="HighlightTranslate" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Resources>
                                <Duration x:Key="FadeOutDuration">00:00:00.150</Duration>

                                <system:Double x:Key="FadeOutOpacity">0.5</system:Double>
                                <local:BoolToDoubleConverter x:Key="ImageOpacityConverter"
                                                             IfTrue="{StaticResource FadeOutOpacity}" IfFalse="1.0" />

                                <Color x:Key="FadeOutColor">Silver</Color>

                                <local:BoolToColorConverter x:Key="ProcessColorConverter"
                                                            IfTrue="{StaticResource FadeOutColor}" IfFalse="Gray" />

                                <Style TargetType="{x:Type TextBlock}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBeingClosed}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ColorAnimation Duration="{StaticResource FadeOutDuration}"
                                                                        Storyboard.TargetProperty="(TextBox.Foreground).(SolidColorBrush.Color)"
                                                                        To="{StaticResource FadeOutColor}" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="{x:Type Image}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBeingClosed}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Duration="{StaticResource FadeOutDuration}"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="{StaticResource FadeOutOpacity}" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Resources>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="560" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <Image Height="26" Grid.Row="0" Grid.Column="0" Margin="3,0"
                                       Opacity="{Binding IsBeingClosed, Converter={StaticResource ImageOpacityConverter}, Mode=OneTime}">
                                    <Image.Source>
                                        <PriorityBinding>
                                            <Binding Path="HWnd"
                                                     Converter="{StaticResource WindowHandleToIconConverter}"
                                                     IsAsync="True" />
                                            <Binding Path="HWnd"
                                                     Converter="{StaticResource WindowHandleToCachedIconConverter}" />
                                        </PriorityBinding>
                                    </Image.Source>
                                </Image>
                                <TextBlock local:FormattedTextAttribute.FormattedText="{Binding Path=FormattedTitle}"
                                           Grid.Row="0" Grid.Column="1" Margin="3,0">
                                </TextBlock>
                                <TextBlock
                                    local:FormattedTextAttribute.FormattedText="{Binding Path=FormattedProcessTitle}"
                                    Grid.Row="0" Grid.Column="2" Margin="0" TextAlignment="Right">
                                    <TextBlock.Foreground>
                                        <SolidColorBrush
                                            Color="{Binding IsBeingClosed, Converter={StaticResource ProcessColorConverter}, Mode=OneTime}" />
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                    <Border x:Name="ItemBorder" CornerRadius="7" Background="Transparent"
                                            Padding="8,7" Margin="0,1">
                                        <VisualStateManager.VisualStateGroups>
                                            <!-- 悬停：自身浅色淡入（选中高亮由列表覆盖层滑动承担） -->
                                            <VisualStateGroup Name="CommonStates">
                                                <VisualState Name="Normal" />
                                                <VisualState Name="MouseOver">
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="ItemBorder"
                                                            Storyboard.TargetProperty="Background.Color"
                                                            To="{StaticResource ItemHoverColor}"
                                                            Duration="0:0:0.10" />
                                                    </Storyboard>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <EventSetter Event="MouseLeftButtonUp" Handler="ListBoxItem_MouseLBClick" />
                        <EventSetter Event="MouseEnter" Handler="ListBoxItem_MouseEnter" />
                    </Style>
                </ListBox.ItemContainerStyle>
              <ListBox.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{DynamicResource ContextClose}" Click="MenuItem_Click_toClose"/>
                  <MenuItem Header="{DynamicResource ContextToFront}" Click="MenuItem_Click_toFront"/>
                  <MenuItem Header="{DynamicResource ContextDuplicate}" Click="MenuItem_Duplicate"/>
                </ContextMenu>
              </ListBox.ContextMenu>
              <!-- Changes inactive selection color to be same as selected -->
                <ListBox.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"
                                     Color="{x:Static SystemColors.HighlightColor}" Opacity=".4" />
                </ListBox.Resources>
            </ListBox>
            <!-- 空列表占位提示（有项时隐藏） -->
            <TextBlock Text="{DynamicResource NoWindowFound}" FontSize="15" Foreground="#8A8F98"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10"
                       Visibility="{Binding HasItems, ElementName=lb, Converter={StaticResource InverseHasItemsToVisibility}}" />
            </Grid>
        </DockPanel>
    </Border>
</Window>
